{
  "name": "data-intelligence-lab-frontend",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/server.mjs --dev",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:real": "playwright test --config playwright.real.config.ts",
    "test:proxy": "node --test tests/security.test.mjs tests/json-body.test.mjs tests/proxy.test.mjs tests/port-file.test.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "lossless-json": "4.3.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3"
  }
}
