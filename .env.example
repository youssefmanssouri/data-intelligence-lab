# Data Intelligence Lab - Example Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.

# Application Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Configuration
# Local directory for datasets, quarantine uploads, and metadata
STORAGE_DIR=~/.data-intelligence-lab/storage

# Resource Limits
MAX_UPLOAD_SIZE_MB=200
QUERY_TIMEOUT_SECONDS=30
DUCKDB_MAX_MEMORY=2GB
