# ==============================================================================
# Data Intelligence Lab - Comprehensive .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python Distribution & Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Coverage & Linters ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Frontend & Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Next.js Build Outputs & Cache ---
.next/
out/
.turbo/
.eslintcache

# --- Secrets, Environment Variables & Credentials ---
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly preserve example environment files
!.env.example

# --- Application Storage, Datasets & Columnar Databases ---
storage/
quarantine/
data/
*.parquet
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# Prevent accidental commit of raw data files while allowing test fixtures
*.csv
*.tsv
*.xlsx
*.jsonl
!tests/fixtures/*.csv
!tests/fixtures/*.tsv

# --- Logs, Diagnostics & Temp Files ---
logs/
*.log
*.tmp
*.temp
*.swp
*.bak
scratch/

# --- Operating System & Editor Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors & IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
